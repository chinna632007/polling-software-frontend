# Frontend environment
# The IP/domain + port of the backend server this frontend talks to.
#
# --- Development (Vite dev server) ---
# Vite proxies /api to the backend. Set VITE_API_TARGET to your backend host.
# Example: VITE_API_TARGET=localhost   VITE_API_TARGET_PORT=3000
#
# --- Production (deployed frontend) ---
# Vite inlines these values into the build. Set VITE_API_TARGET to your
# backend URL (http://server-ip or https://your-domain.com). No source edits.
#
# --- Local tunnel (optional) ---
# If you want the deployed frontend to reach a locally-running backend through
# a public ngrok URL, set:
#   VITE_API_TARGET=http://localhost
#   VITE_API_TARGET_PORT=4040
# ...and run: ngrok http 3000   (or whatever your backend port is)

VITE_API_TARGET=http://10.107.71.91
VITE_API_TARGET_PORT=3000

# Optional: public ngrok/Cloudflare URL your deployed app should call back to.
# When set, the app uses this URL for callback redirects instead of the
# localhost/dev origin. Typically http://<your-ngrok-domain>:4040.
VITE_CALLBACK_ORIGIN=http://10.107.71.91
